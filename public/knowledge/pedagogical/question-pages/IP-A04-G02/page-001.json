[{"index":0,"question":{"schemaVersion":"2.0.0","officialQuestionId":"OQ-A04-aula04.q0005","lessonId":"A04","sourceQuestionId":"aula04.q0005","questionPayload":{"question_id":"aula04.q0005","occurrence_type":"commented_section","source_section_id":"aula04.sec09","source_number":5,"question_type":"true_false_or_statement","exam_board":"CEBRASPE","organization":"PC-PE","position":null,"year":2024,"support_text":null,"prompt":"Em relação a aspectos linguísticos do trecho “Espanto, e enorme, senti ao enxergar meu pai abatido na sala, o gesto lento. Habituara-me a vê-lo grave, silencioso, acumulando energia para gritos medonhos”, , julgue o item a seguir.\n\nO tempo em que está flexionada a forma verbal “Habituara” projeta essa ação para o futuro.","options":[],"tests_concept_ids":["pt.grammar.tempo_verbal"],"tests_rule_ids":["rule.aula04.0004","rule.aula04.0021","rule.aula04.0031","rule.aula04.0156","rule.aula04.0228"],"source":{"document_id":"aula04_complete","page_ids":["aula04_complete.p0072"]},"annotation_state":"outside_annotated_scope","extraction_confidence":0.96},"questionSha256":"72cfad06422e050285fa28ec6a5f57b494d3f4fa8de1d475d85e04c89865418c","answerPayload":{"answer_id":"aula04.q0005.answer","question_id":"aula04.q0005","answer":null,"commentary":"Não há futuro. \"habituaRA\" é forma do pretérito mais-que-perfeito do indicativo. O narrador \"tinha/havia\" se habituado a ver o pai de outra maneira antes da cena narrada. Incorreto. BACEN - Língua Portuguesa 71 www.estrategiaconcursos.com.br 154","justification_unit_ids":[],"source":{"document_id":"aula04_complete","page_ids":["aula04_complete.p0072"]},"confidence":0.86},"answerSha256":"9d38c4b4a461a2101a10ef3e69992679bfe00d695091797071be37042452b3da","immutabilityPolicy":"payload_must_match_corpus_apostila_exactly"}},{"index":1,"question":{"schemaVersion":"2.0.0","officialQuestionId":"OQ-A04-aula04.q0080","lessonId":"A04","sourceQuestionId":"aula04.q0080","questionPayload":{"question_id":"aula04.q0080","occurr