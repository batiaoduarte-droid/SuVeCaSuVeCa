{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "node scripts/clean.mjs",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:firestore": "node tests/firestore-rules.mjs",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "audit:pedagogical": "node scripts/audit-pedagogical-curriculum.mjs && node scripts/audit-deployment-shards.mjs && node scripts/audit-question-presentations.mjs && node scripts/audit-pedagogical-views.mjs && node scripts/audit-pedagogical-view-index.mjs && node scripts/audit-pedagogical-macros.mjs",
    "audit:pbl": "node scripts/audit-pbl-runtime.mjs",
    "audit:view-index": "node scripts/audit-pedagogical-view-index.mjs",
    "audit:macro-index": "node scripts/audit-pedagogical-macro-index.mjs",
    "audit:macros": "node scripts/audit-pedagogical-macros.mjs",
    "ai-studio:preflight": "node scripts/ai-studio-preflight.mjs",
    "typecheck": "tsc --noEmit",
    "audit:tutor": "node scripts/audit-pbl-tutor.mjs",
    "audit:packages": "node scripts/audit-pbl-packages.mjs",
    "validate:knowledge": "npm run audit:artifacts && npm run audit:pedagogical && npm run audit:pbl && npm run audit:tutor && npm run audit:packages",
    "verify:release": "node scripts/ai-studio-preflight.mjs --release",
    "typecheck:functions": "npm --prefix functions run lint",
    "build:functions": "npm --prefix functions run build",
    "eval:ai": "node scripts/run-ai-evals.mjs",
    "audit:artifacts": "node scripts/audit-product-artifacts.mjs",
    "build:server": "node scripts/build-server.mjs",
    "build:production": "npm run build && npm run build:server",
    "start:production": "node server-dist/server.cjs",
    "package:production": "npm run build:production && node scripts/package-production.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.17.1",
    "firebase-admin": "^13.10.0",
    "katex": "^0.18.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "ajv": "^8.17.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.19.0 <25",
    "npm": ">=10 <12"
  },
  "packageManager": "npm@11.11.0"
}
