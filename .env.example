# Gemini API Key (Required for server-side AI features)
GEMINI_API_KEY=

# Firebase Push Notifications (Optional)
VITE_FIREBASE_VAPID_KEY=

# Feature Flags
VITE_MACRO_CURRICULUM_ENABLED=true

# PBL Tutor Configuration (Optional)
PBL_TUTOR_ENABLED=true
PBL_TUTOR_MODEL=gemini-3.1-flash-lite
PBL_TUTOR_THINKING_LEVEL=low

# Knowledge Directory Override (Optional)
SUVECA_KNOWLEDGE_DIR=
